# 원본 데이터: 파일당 100MB 제한을 넘는다 → DATA.md의 주소·지문으로 받는다(./fetch_data.sh)
/data/

# 컴파일 결과: ./bench.sh build로 다시 만든다
/alloc_bench
/replay

# 파이썬 캐시
__pycache__/
*.pyc

# 측정 출력, 도구 시험 출력
/out/
/test/

# 중간 산출물: 다시 만들 수 있다(README §6·§7). 실험이 읽는 일정(exp/sched, exp/fx/sched)은 올린다
/exp/traces/
/exp/fx/traces/

# 봉인 실행이 다시 만드는 일정·합성 입력. 결과(exp/sealed/res)는 실행 뒤 올린다
/exp/sealed/sched/
/exp/sealed/sens_sched/
/exp/sealed/fx/
# 분할 실행의 묶음별 중간 결과(이어 붙인 결과는 exp/sealed/res에 있다)
/exp/sealed/res/parts/*.csv
/exp/sealed/res/parts/*.done
/exp/sealed/res/parts/tmp_*

# 3단계 측정: 빌드 결과, 정책 사건 목록(크다, 다시 만든다)
/chunkpool
/exp/stage3/dec/
# v2 봉인 실행이 다시 만드는 일정·합성 입력과 묶음별 중간 결과
/exp/sealed_v2/sched/
/exp/sealed_v2/fx/
/exp/sealed_v2/res/parts/*.csv
/exp/sealed_v2/res/parts/*.done
/exp/sealed_v2/res/parts/tmp_*
# 개발용 '하루 전체' 평가의 입력(원본에서 다시 만든다: exp/v2dev/daypool/run.sh)
/exp/v2dev/daypool/traces/
/exp/v2dev/daypool/sched/
/exp/v2dev/daypool/inputs.done
/exp/sealed_v2/day/sched/
